# ---------------------------------------------------------------------------
# Recipient source: "postgres" (docker-compose.yml) or "csv" (data/students.csv)
# ---------------------------------------------------------------------------
RECIPIENT_SOURCE=postgres

# These are read by docker-compose.yml AND by the application, so the two
# always agree. Change POSTGRES_PASSWORD before running anywhere real.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=classreminer
POSTGRES_USER=classreminer
POSTGRES_PASSWORD=change-me
POSTGRES_CONNECT_TIMEOUT=10

# Port for the Adminer web GUI (http://localhost:8080). Change it if that port
# is already taken — Docker reports the clash as "port is already allocated".
ADMINER_PORT=8080

# Overrides the four settings above when set (e.g. a managed database).
# DATABASE_URL=postgresql://user:pass@host:5432/classreminer

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# Bots
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
SCHEDULE_TOLERANCE_MINUTES=5
NOTIFICATION_LEAD_MINUTES=30
